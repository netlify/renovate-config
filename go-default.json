{
  "extends": [
    "config:recommended",
    "customManagers:dockerfileVersions",
    "customManagers:githubActionsVersions"
  ],
  "rebaseWhen": "conflicted",
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "docker-compose": {
    "enabled": false
  },
  "env": {
    "GOPRIVATE": "github.com/netlify/*"
  },
  "labels": [
    "dependencies"
  ],
  "prBodyNotes": [
    "{{#if isMajor}}:warning: MAJOR MAJOR MAJOR :warning:{{/if}}"
  ],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "digest": {
        "dependencyDashboardApproval": true
      },
      "addLabels": [
        "golang"
      ]
    },
    {
      "matchPackageNames": [
        "/^github\\.com/netlify//"
      ],
      "minimumReleaseAge": null
    },
    {
      "matchPackageNames": [
        "/^github\\.com/aws/aws-sdk-go-v2(/|$)/",
        "/^github\\.com/aws/aws-lambda-go$/",
        "/^github\\.com/aws/aws-sdk-go$/"
      ],
      "groupName": "aws-sdk"
    },
    {
      "matchPackageNames": [
        "/^golang\\.org/x//"
      ],
      "groupName": "golang-x"
    },
    {
      "matchPackageNames": [
        "github.com/DataDog/datadog-go/v5",
        "gopkg.in/DataDog/dd-trace-go.v1"
      ],
      "groupName": "datadog"
    },
    {
      "matchPackageNames": [
        "google.golang.org/api",
        "cloud.google.com/go/storage"
      ],
      "groupName": "google-sdk"
    },
    {
      "matchManagers": [
        "gomod",
        "custom.regex",
        "docker"
      ],
      "matchPackageNames": [
        "go",
        "golang"
      ],
      "groupName": "Go version"
    },
    {
      "matchManagers": [
        "circleci"
      ],
      "matchPackageNames": [
        "cimg/go"
      ],
      "groupName": "Go version"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^KSGFile(\\.ya?ml)?$/"
      ],
      "matchStrings": [
        "ksg_version: \"?(?<currentValue>v\\d+(\\.\\d+(\\.\\d+([-\\.][\\w\\.-]+)?)?)?)\"?"
      ],
      "depNameTemplate": "KSG",
      "packageNameTemplate": "netlify/ksg-cli",
      "datasourceTemplate": "github-releases"
    }
  ]
}
