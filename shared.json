{
  "extends": [
    "config:recommended",
    "schedule:weekly",
    "helpers:pinGitHubActionDigests"
  ],
  "rangeStrategy": "update-lockfile",
  "major": {
    "automerge": false
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "labels": ["dependencies"],
  "rebaseWhen": "conflicted",
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "Pinning an action to the SHA its tag already resolves to changes nothing that runs.",
      "matchDepTypes": ["action"],
      "matchUpdateTypes": ["pinDigest"],
      "automerge": true
    },
    {
      "description": "Renovate has no release timestamps for a regenerated lockfile, so the stability-days check never passes. pnpm and npm enforce the release age themselves during regeneration.",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    },
    {
      "matchManagers": ["npm"],
      "addLabels": ["javascript"]
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^@netlify/", "/^netlify/", "/^github.com/netlify/"],
      "rangeStrategy": "bump",
      "schedule": null,
      "minimumReleaseAge": null
    },
    {
      "matchManagers": ["npm"],
      "matchSourceUrls": ["https://github.com/netlify/build{/,}**"],
      "groupName": "Netlify packages"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@netlify/zip-it-and-ship-it"],
      "groupName": "Netlify packages"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["/inquirer/"],
      "groupName": "Inquirer packages"
    }
  ]
}
